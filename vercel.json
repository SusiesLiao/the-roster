{
  "redirects": [
    {
      "source": "/app",
      "destination": "https://my.theroster.studio",
      "permanent": false
    },
    {
      "source": "/app/(.*)",
      "destination": "https://my.theroster.studio/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.velaireco.com"
        }
      ],
      "destination": "https://velaireco.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.theroster.studio"
        }
      ],
      "destination": "https://theroster.studio/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|favicon|robots\\.txt|sitemap\\.xml|\\.well-known|cadence/).*)",
      "destination": "/index.html"
    }
  ]
}
